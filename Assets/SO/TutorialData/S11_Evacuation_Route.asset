  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: S11_Evacuation_Route
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Emergency Procedures \u2014 Evacuation Route"
  <Description>k__BackingField: Now follow the green floor arrows to the muster point
    outside the warehouse. In a real emergency, you do not stop to collect belongings,
    you do not use lifts, and you do not re-enter the building under any circumstances
    until a supervisor or emergency services confirm it is safe. The muster point
    is where a headcount is taken to confirm everyone has evacuated. Knowing this
    route before an emergency occurs is the difference between an orderly evacuation
    and a dangerous one. Follow the route now.
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: 8740c1c76adf0c544989e8e646a75141, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Follow the Evacuation Route to the Muster Point
    <ChallengeTriggerName>k__BackingField: TRIGGER_Safety_ReachMusterPoint
    <IsComplete>k__BackingField: 0
