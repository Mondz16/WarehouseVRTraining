  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M1_06_Multi_Line_Order
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Multi-Line Order \u2014 Planning Before Moving"
  <Description>k__BackingField: Your next pick list has 3 items across two aisles,
    Aisles B and C. Before you move, read all three lines and plan your route. The
    most efficient approach is to pick all items in one aisle before moving to the
    next. Do not pick in pick list order if the order sends you back and forth between
    aisles, the pick list order is generated by the customer, not by your warehouse
    layout. Check the aisle, shelf, and bin for all three items, decide the most
    efficient sequence, and then start moving. The AI will record your route.
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: 71ae3510e6f672c4bae3dee39fee9adf, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 0
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Complete All 3 Picks in the Multi-Line Order
    <ChallengeTriggerName>k__BackingField: TRIGGER_M1_MultiLine_AllPicked
    <IsComplete>k__BackingField: 0
