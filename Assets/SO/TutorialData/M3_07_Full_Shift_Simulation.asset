  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M3_07_Full_Shift_Simulation
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Full Shift Simulation \u2014 10 Orders"
  <Description>k__BackingField: You will now complete a 10-order picking simulation.
    Each order is assigned by the AI based on your performance in the previous stages.
    The AI tracks your total distance walked, the number of zone re-entries, idle
    time, and efficiency percentage compared to the optimal route for each order.
    There is no guide or overlay during this simulation, apply everything you have
    learned. Plan before you move, sequence your zones, batch where possible, and
    re-route when blocked. Your cumulative efficiency score will be shown at the
    end.
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: bdfdf00f6654f6c40bf0b4211e89740f, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Complete All 10 Orders in the Shift Simulation
    <ChallengeTriggerName>k__BackingField: TRIGGER_M3_ShiftSimulationComplete
    <IsComplete>k__BackingField: 0
