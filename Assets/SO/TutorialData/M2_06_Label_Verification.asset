  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M2_06_Label_Verification
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Label Verification \u2014 Three Things to Check"
  <Description>k__BackingField: 'The shipping label has been printed and is ready
    on the label printer to your right. Before you apply it, verify three things:
    the delivery address matches the order on your panel, the weight class on the
    label is consistent with the item weight, and the carrier code is correct. Applying
    a label with an incorrect address sends the parcel to the wrong customer. An
    incorrect weight class results in a carrier surcharge or return. Scan the label
    with the virtual scanner to perform the verification check, then apply it to
    the largest flat face of the box.'
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: a047c4aae88bc274887b211376ade8f6, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Scan and Verify the Shipping Label
    <ChallengeTriggerName>k__BackingField: TRIGGER_M2_LabelVerified
    <IsComplete>k__BackingField: 0
  - <ChallengeTitle>k__BackingField: Apply the Label to the Box
    <ChallengeTriggerName>k__BackingField: TRIGGER_M2_LabelApplied
    <IsComplete>k__BackingField: 0
