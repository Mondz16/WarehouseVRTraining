  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M1_04_SKU_Verification
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "SKU Verification \u2014 Never Pick on Description Alone"
  <Description>k__BackingField: You are now at the correct bin. Before you pick the
    item, you must verify its SKU. Product descriptions can be similar or abbreviated
    in ways that create confusion for example, a bin labelled 'Blue Widget 500ml'
    may sit next to 'Blue Widget 750ml'. The SKU eliminates that ambiguity. Use the
    virtual scanner on your right hand, grip the scanner tool from your hip, point
    it at the item's barcode label on the shelf face, and press trigger to scan.
    The scanner will confirm a match in green or flag a mismatch in red. Only pick
    the item after a green confirmation.
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: f815b8e3b18346d48af082d73c62331b, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Scan and Verify the Item SKU
    <ChallengeTriggerName>k__BackingField: TRIGGER_M1_ScanSKU_Verified
    <IsComplete>k__BackingField: 0
