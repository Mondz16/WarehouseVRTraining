  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M1_03_Reading_Pick_Location
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Reading Your First Pick \u2014 Location"
  <Description>k__BackingField: 'Your first pick list has one item. The location
    shown is A-02-03, which means Aisle A, Shelf 2, Bin 3. Warehouse locations follow
    this structure in most facilities: the letter identifies the aisle, the first
    number identifies the shelf level from the floor (1 is ground level, 2 is mid-level,
    3 is top), and the second number identifies the bin position along the shelf
    from left to right. Aisle A is the first aisle on your left. Walk there now and
    find the correct shelf and bin before touching anything.'
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: e4452f9fa848d5e49a9fa7a8554ed40c, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Navigate to Location A-02-03
    <ChallengeTriggerName>k__BackingField: TRIGGER_M1_ReachLocation_A0203
    <IsComplete>k__BackingField: 0
