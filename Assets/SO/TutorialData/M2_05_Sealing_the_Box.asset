  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M2_05_Sealing_the_Box
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: Sealing the Box
  <Description>k__BackingField: With the item packed and void fill applied, seal
    the box using the tape gun on the bench. The correct sealing method is the H-tape
    pattern, one strip along the centre seam and one strip along each end seam, forming
    an H shape. This provides maximum strength at the points where cartons are most
    likely to open under load. A single strip along the centre seam is not sufficient
    for transit,  carriers handle thousands of parcels per hour and a poorly sealed
    box will open. Apply the H-tape pattern now.
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: 7e58d48918d5e2241888565bc9c66c7e, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 0
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Apply the H-Tape Sealing Pattern
    <ChallengeTriggerName>k__BackingField: TRIGGER_M2_BoxSealed
    <IsComplete>k__BackingField: 0
