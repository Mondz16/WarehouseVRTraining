  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: S05_Hazard_Walk_Introduction
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Hazard Walk \u2014 What to Look For"
  <Description>k__BackingField: 'You are now on the warehouse floor. Four safety
    hazards have been staged in this environment. Your task is to walk through the
    warehouse, identify each hazard, and interact with it to log it. In a real facility,
    a logged hazard triggers an immediate response, a supervisor is notified, the
    area is cordoned off, and the hazard is resolved before work continues. The four
    hazards in this environment represent the most common warehouse incidents: wet
    floors, blocked exits, unstable racking, and unsecured loads. Failing to identify
    and report any of these in a live environment puts every person on the floor
    at risk.'
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: dc29d282c38c4454f88818c6b6ce0db3, type: 3}
