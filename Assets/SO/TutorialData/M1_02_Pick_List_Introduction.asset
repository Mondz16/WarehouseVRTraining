  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M1_02_Pick_List_Introduction
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "The Pick List \u2014 Your Instruction Sheet"
  <Description>k__BackingField: 'Every picking task begins with a pick list either
    printed or displayed on a handheld scanner. Your virtual pick list appears on
    the wrist panel of your left hand. Open it now by raising your left wrist. The
    pick list shows you four pieces of information for each item: the SKU (Stock
    Keeping Unit), a unique product identifier, the product description, the storage
    location (aisle, shelf, and bin number), and the quantity required. Read each
    line carefully before you move. Picking the wrong item or wrong quantity is far
    more costly than taking an extra few seconds to verify.'
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: dc676d1f3dce8a34fb27ea8482249ab1, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 0
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Open the Wrist Pick List Panel
    <ChallengeTriggerName>k__BackingField: TRIGGER_M1_OpenPickList
    <IsComplete>k__BackingField: 0
