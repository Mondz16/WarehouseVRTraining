  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: S10_Fire_Extinguisher_Location
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: "Emergency Procedures \u2014 Fire Extinguisher Location"
  <Description>k__BackingField: 'You have logged all four hazards. Now we cover emergency
    procedures. Every person on the warehouse floor must know three things before
    starting their shift: where the nearest fire extinguisher is, where the muster
    point is, and which route to take to get there. The fire extinguisher in this
    zone is mounted on the wall near the exit corridor. It is a CO2 extinguisher,
    suitable for electrical fires, which are the most common warehouse fire type.
    Walk to the extinguisher and interact with it to register its location.'
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: b10470bde13c2fe44a3b388f2a828b04, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Locate and Register the Fire Extinguisher
    <ChallengeTriggerName>k__BackingField: TRIGGER_Safety_RegisterExtinguisher
    <IsComplete>k__BackingField: 0
