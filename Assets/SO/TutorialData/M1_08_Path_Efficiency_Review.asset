  m_Script: {fileID: 11500000, guid: 9f98f165057dfa845a762fb8ffaa2135, type: 3}
  m_Name: M1_08_Path_Efficiency_Review
  m_EditorClassIdentifier: Assembly-CSharp::Valari.Data.TutorialData
  <Title>k__BackingField: Path Efficiency Review
  <Description>k__BackingField: Your picking session is complete. The AI has now
    analysed your route through the warehouse and compared it to the optimal path.
    On the floor you can see two overlaid lines, a green line showing the optimal
    route, and an amber line showing your actual route. Every metre of unnecessary
    travel in a warehouse adds up across a shift. A picker walking 15 kilometres
    per shift who reduces their travel by 15 percent saves over 2 kilometres of walking
    per day. Study the difference between your route and the optimal route before
    continuing. The AI will highlight specific points where you backtracked or visited
    zones out of sequence.
  <VoiceOver>k__BackingField: {fileID: 8300000, guid: 2b812454382f9b9418900620f21b368b, type: 3}
  <HasChallenges>k__BackingField: 1
  <IsInOrder>k__BackingField: 1
  TutorialChallengeLists:
  - <ChallengeTitle>k__BackingField: Review the Path Comparison Display
    <ChallengeTriggerName>k__BackingField: TRIGGER_M1_PathReviewConfirmed
    <IsComplete>k__BackingField: 0
